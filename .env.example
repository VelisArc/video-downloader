# ═══════════════════════════════════════════════════════════════
# SwiftDL v3.0 — Environment Variables
# Copy this file to .env and fill in your keys
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# FIREBASE CLIENT (Frontend — Vite)
# Get these from Firebase Console → Project Settings → General
# ──────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ──────────────────────────────────────────────────────────────
# FIREBASE ADMIN (Backend — Vercel Serverless)
# Get from Firebase Console → Project Settings → Service Accounts
# → Generate new private key → paste the JSON
# ──────────────────────────────────────────────────────────────
# Option A: Paste the full JSON as a single line
FIREBASE_ADMIN_JSON=

# Option B: Base64-encoded JSON (preferred for Vercel)
# FIREBASE_ADMIN_JSON_B64=

# ──────────────────────────────────────────────────────────────
# RAZORPAY PAYMENT GATEWAY
# Get from Razorpay Dashboard → Settings → API Keys
# ──────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret for subscription auto-renewal
# Get from Razorpay Dashboard → Webhooks → Create webhook → Secret
RZP_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────
# PAYMENT CONFIGURATION
# ──────────────────────────────────────────────────────────────
PAYMENT_CURRENCY=INR
# Amounts in smallest currency unit (paise for INR, cents for USD)
MONTHLY_AMOUNT=19900
LIFETIME_AMOUNT=99900

# ──────────────────────────────────────────────────────────────
# DOWNLOAD LIMITS (per day, 0 = unlimited)
# ──────────────────────────────────────────────────────────────
GUEST_DAILY_LIMIT=1
USER_DAILY_LIMIT=3
MONTHLY_DAILY_LIMIT=0
LIFETIME_DAILY_LIMIT=0

# ──────────────────────────────────────────────────────────────
# RATE LIMITING & ANTI-ABUSE
# ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=30
MAX_INFLIGHT=3
COOLDOWN_SEC=0

# ──────────────────────────────────────────────────────────────
# COOKIE VAULT
# ──────────────────────────────────────────────────────────────
MAX_COOKIE_TXT_LEN=1048576
PREMIUM_COOKIE_VAULT_LIMIT=0

# ──────────────────────────────────────────────────────────────
# COOKIES ENCRYPTION (for cookie vault security)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ──────────────────────────────────────────────────────────────
COOKIES_FERNET_KEY=

# ──────────────────────────────────────────────────────────────
# OPTIONAL: Platform-specific cookies (Netscape format, base64)
# ──────────────────────────────────────────────────────────────
# INSTAGRAM_COOKIES_B64=
# FACEBOOK_COOKIES_B64=

# ──────────────────────────────────────────────────────────────
# CORS (comma-separated origins, empty = allow all)
# ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://swiftdownlod.online

# ──────────────────────────────────────────────────────────────
# GOOGLE ADSENSE (optional)
# ──────────────────────────────────────────────────────────────
# VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
